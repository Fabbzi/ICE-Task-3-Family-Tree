<Window x:Class="RoyalFamilyTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Royal Family Tree - The House of Windsor" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="The House of Windsor" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Royal Family Tree Visualization" 
                          FontSize="14" 
                          Foreground="#BDC3C7"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search and Add Controls -->
        <Border Grid.Row="1" Background="#34495E" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Search Panel -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Search:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" Width="250" Height="25" VerticalContentAlignment="Center" 
                             Background="White" Padding="5,0"/>
                    <Button x:Name="SearchButton" Content="Search" Width="80" Height="25" Margin="10,0,0,0"
                            Background="#3498DB" Foreground="White" BorderThickness="0" 
                            FontWeight="Bold" Click="SearchButton_Click"/>
                    <Button x:Name="ClearSearchButton" Content="Clear" Width="60" Height="25" Margin="5,0,0,0"
                            Background="#95A5A6" Foreground="White" BorderThickness="0" 
                            FontWeight="Bold" Click="ClearSearchButton_Click"/>
                </StackPanel>

                <!-- Add Member Button -->
                <Button x:Name="AddMemberButton" Grid.Column="1" Content="+ Add Family Member" 
                        Height="25" Padding="15,0" Background="#27AE60" Foreground="White" 
                        BorderThickness="0" FontWeight="Bold" Click="AddMemberButton_Click"/>
            </Grid>
        </Border>

        <!-- Tree View -->
        <ScrollViewer Grid.Row="2" 
                     HorizontalScrollBarVisibility="Auto" 
                     VerticalScrollBarVisibility="Auto"
                     Background="#ECF0F1">
            <StackPanel x:Name="TreePanel" Margin="20"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#34495E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Legend: " Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Border Background="#2ECC71" Padding="5,2" Margin="5,0" CornerRadius="3">
                    <TextBlock Text="Alive" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#95A5A6" Padding="5,2" Margin="5,0" CornerRadius="3">
                    <TextBlock Text="Deceased" Foreground="White" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
