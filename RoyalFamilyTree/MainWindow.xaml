<Window x:Class="RoyalFamilyTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Royal Family Tree - The House of Windsor" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="The House of Windsor" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Royal Family Tree Visualization" 
                          FontSize="14" 
                          Foreground="#BDC3C7"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tree View -->
        <ScrollViewer Grid.Row="1" 
                     HorizontalScrollBarVisibility="Auto" 
                     VerticalScrollBarVisibility="Auto"
                     Background="#ECF0F1">
            <StackPanel x:Name="TreePanel" Margin="20"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Legend: " Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Border Background="#2ECC71" Padding="5,2" Margin="5,0" CornerRadius="3">
                    <TextBlock Text="Alive" Foreground="White" FontSize="11"/>
                </Border>
                <Border Background="#95A5A6" Padding="5,2" Margin="5,0" CornerRadius="3">
                    <TextBlock Text="Deceased" Foreground="White" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
